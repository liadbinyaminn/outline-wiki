# --- General ---
NODE_ENV=production
URL=https://outline.liadev
PORT=3000

# --- Security ---
# Generate these with ⁠ openssl rand -hex 32 ⁠
SECRET_KEY=generate_a_secure_random_hex_string
UTILS_SECRET=generate_another_secure_random_hex_string

# --- Database ---
DATABASE_URL=postgres://outline:outline_password@postgres:5432/outline
DATABASE_CONNECTION_POOL_MIN=5
DATABASE_CONNECTION_POOL_MAX=20
# Variables for the Postgres container itself
POSTGRES_USER=outline
POSTGRES_PASSWORD=outline_password
POSTGRES_DB=outline
PGSSLMODE=disable

# --- Redis ---
REDIS_URL=redis://redis:6379

# --- Authentication (Slack OIDC) ---
OIDC_ISSUER_URL=https://slack.com
OIDC_CLIENT_ID=get_from_slack_app_credentials
OIDC_CLIENT_SECRET=get_from_slack_app_credentials
OIDC_SCOPES=openid profile email
OIDC_USERNAME_CLAIM=email
OIDC_DISPLAY_NAME=Slack

# --- Backup ---
BACKUP_ENCRYPTION_KEY=generate_a_strong_password_for_backup_encryption
